PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/city-pulse

# Signs and verifies auth tokens. Required when NODE_ENV=production — the server
# refuses to start without it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=30d

# SMTP credentials used for password reset emails. Use your provider's SMTP
# settings; SMTP_PORT is commonly 587 (STARTTLS) or 465 (implicit TLS).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM=City Pulse <no-reply@example.com>
# Optional; defaults to the app's citypulse://reset-password deep link.
PASSWORD_RESET_URL=citypulse://reset-password

# Where uploaded listing photos are written. Point this at a mounted volume or a
# directory your object-storage sync watches if you move off local disk.
UPLOAD_DIR=./uploads

# Google Maps Platform — server-side only. Never expose this as an EXPO_PUBLIC_*
# variable, never commit a real value, and never return it in a response.
#
# The backend proxies Places autocomplete, Place details, reverse geocoding and
# Routes directions to Google with this key. The mobile app keeps its own
# Android-restricted key for the native MapView, but that key cannot be used
# for Google's web services: Google rejects those calls with
# "API_KEY_ANDROID_APP_BLOCKED" because a request from the app carries no
# Android application identity.
#
# Create this key in the same Google Cloud project as the app's key, with:
#   - "Places API (New)" enabled
#   - "Routes API" enabled
#   - "Geocoding API" enabled
# Application restrictions: API only (no Android/iOS app restriction). An IP
# restriction can be added later, once the deployed backend's outbound IPs are
# known and stable — do not assume they are.
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
TERMII_API_KEY=your_secret_key
TERMII_BASE_URL=Your_termii_base_url

# Development only. When true, OTPs are logged to the server console instead of
# texted and are also returned by POST /auth/send-otp as `devOtp`, so a client
# can complete signup without a real number. Signup still creates the account
# and still issues a real JWT — the code is only the delivery step that is
# short-circuited. Must be false (or unset) in production.
TERMII_DEV_MODE=true
